{
  "name": "misupertostada",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter web dev",
    "dev:api": "bun run --filter api start:dev",
    "dev:start": "bun run --filter web dev && bun run --filter api start:dev",
    "dev:all": "bun run scripts/dev-all.ts",
    "build": "bun run --filter web build && bun run --filter api build",
    "lint": "bun run --filter web lint",
    "test": "bun test --timeout 15000 --max-concurrency 8",
    "typecheck": "bun run --filter api typecheck && bun run --filter web typecheck",
    "db:create": "bun packages/db/src/create-db.ts",
    "db:migrate": "bun run --filter @misupertostada/db migrate",
    "db:seed": "bun packages/db/src/seed.ts",
    "db:seed:mega": "bun packages/db/src/seed-mega.ts",
    "db:seed:mega:clear": "bun packages/db/src/seed-mega.ts --clear",
    "db:setup": "bun run db:create && bun run db:migrate && bun run db:seed",
    "db:up": "docker compose up -d",
    "db:purge:test-data": "bun packages/db/src/purgar-datos-de-prueba.ts",
    "db:test:create": "bun packages/db/src/create-test-db.ts",
    "db:test:migrate": "bun packages/db/src/migrate-test-db.ts",
    "db:test:setup": "bun run db:test:create && bun run db:test:migrate",
    "r2:cors": "bun scripts/r2-cors.ts",
    "assets:variants:regenerate": "bun apps/api/scripts/regenerate-variants.ts"
  },
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "react-hook-form": "^7.85.0"
  }
}
