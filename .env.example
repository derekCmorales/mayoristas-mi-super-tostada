NODE_ENV=development
# Postgres 18 nativo. Docker Compose (db:up) es solo empaquetado.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/misupertostada
# Base de los tests. Si se omite, se deriva de DATABASE_URL añadiendo `_test`.
# Nunca apuntarla a la de desarrollo: los e2e dejan una organización por test.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/misupertostada_test
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Front (Next.js). La API corre en API_PORT.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sesión interna (cookie httpOnly). No es JWT.
SESSION_COOKIE_NAME=session
SESSION_TTL_SECONDS=604800

# Solo desarrollo. En production no se seedan usuarios.
SEED_ADMIN_PASSWORD=dev-local-only

# R2 — opcional en development (usa FakeStorageAdapter).
# Obligatorio en production. El bucket ya existe; pegar keys aquí, nunca en git.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Cifrado en reposo (32 bytes hex). Obligatorio en production.
# openssl rand -hex 32
# APP_ENCRYPTION_KEY=

# WhatsApp Cloud API — opcional. Sin esto el Fake adapter cubre el desarrollo.
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=
# META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v21.0
# Conexión WABA hecha por el onboarding del tech provider (no Embedded Signup).
# Las tres juntas + META_APP_ID; la API las importa cifradas a conexion_waba al arrancar.
# NO las pongas en el .env local: el dev mandaría WhatsApps reales.
# META_WABA_ID=
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=


# Producción (VPS / Openship): no las uses en local. Ver DEPLOY.md y
# deploy/openship.env.example
# BOOTSTRAP_ADMIN_USERNAME=cristian
# BOOTSTRAP_ADMIN_PASSWORD=
# SEED_ON_BOOT=false

