# API NestJS. Build con Bun; runtime Node LTS (AGENTS.md §3.1).
# Plataforma linux/amd64: el VPS es AMD EPYC, no el chip del Mac.
#
# Build en oven/bun: Bun ya viene en la imagen — sin apt-get ni curl a bun.sh.
# En el VPS, deb.debian.org:80 suele hacer timeout; instalar paquetes en build
# rompe el deploy. argon2/sharp usan prebuilds linux/amd64.
#
# Runner en node:22-bookworm-slim. Bun se copia desde build (no re-pull de oven/bun).
#
# Un solo stage de build: copiar fuente → instalar → compilar.
# Openship inyecta NODE_ENV=production y bun run ejecuta scripts con bash
# sin node_modules/.bin en PATH. Por eso: --production=false y bunx.
# Versión exacta, no `1.x`: un tag flotante cambia el runtime sin commit.
# 1.4.4 trae el arreglo de seguridad del decodificador Brotli (aviso de Openship).
FROM oven/bun:1.4.4-debian AS build
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/api apps/api
COPY apps/web/package.json apps/web/package.json
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY packages/pdf packages/pdf
# Openship inyecta NODE_ENV=production; bun entonces omite devDeps (`nest`).
# `--production` es flag booleano en Bun: no admite `=false`.
RUN unset NODE_ENV && bun install --frozen-lockfile
WORKDIR /app/apps/api
ENV NODE_ENV=production
RUN bunx nest build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
COPY --from=build /usr/local/bin/bun /usr/local/bin/bun
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps ./apps
COPY --from=build /app/packages ./packages
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/bun.lock ./bun.lock
COPY deploy/entrypoint-api.sh /app/deploy/entrypoint-api.sh
RUN chmod +x /app/deploy/entrypoint-api.sh \
  && ARGON2_DIR="$(cd /app/apps/api && node -p "require('path').dirname(require.resolve('argon2/package.json'))")" \
  && (cd "$ARGON2_DIR" && npm run install)
ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=640
WORKDIR /app
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=10s --start-period=180s --retries=12 \
  CMD node -e "fetch('http://127.0.0.1:3001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/app/deploy/entrypoint-api.sh"]
