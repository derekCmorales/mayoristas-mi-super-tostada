# Next.js standalone. `next dev` local no usa esta imagen.
#
# Build en oven/bun: sin apt-get (deb.debian.org:80 hace timeout en el VPS).
# Runner en node:22-bookworm-slim (standalone de Next).
#
# Un solo stage de build: copiar fuente → instalar → compilar.
# Openship inyecta NODE_ENV=production y bun run ejecuta scripts con bash
# sin node_modules/.bin en PATH. Por eso: --production=false y bunx.
FROM oven/bun:1.3-debian AS build
WORKDIR /app
COPY package.json bun.lock ./
COPY apps/web apps/web
COPY apps/api/package.json apps/api/package.json
COPY packages/shared packages/shared
COPY packages/db/package.json packages/db/package.json
COPY packages/pdf/package.json packages/pdf/package.json
# Openship inyecta NODE_ENV=production; bun entonces omite devDeps (`typescript`).
# `--production` es flag booleano en Bun 1.3: no admite `=false`.
RUN unset NODE_ENV && bun install --frozen-lockfile --linker=hoisted
# Default de producción (Openship no inyecta build args al compose). Override:
#   docker build --build-arg NEXT_PUBLIC_API_URL=https://… -f deploy/Dockerfile.web .
ARG NEXT_PUBLIC_API_URL=https://apipedidos.misupertostada.com
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
WORKDIR /app/apps/web
RUN bunx next build

FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NODE_OPTIONS=--max-old-space-size=448
COPY --from=build /app/apps/web/.next/standalone ./
# Bun isolated deja rutas .bun/ en el standalone; copiamos el store para Node.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/.next/static ./.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
COPY --from=build /app/apps/web/public ./public
COPY deploy/entrypoint-web.sh /app/entrypoint-web.sh
RUN chmod +x /app/entrypoint-web.sh
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=10s --start-period=90s --retries=12 \
  CMD node -e "fetch('http://127.0.0.1:3000/login').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["/app/entrypoint-web.sh"]
